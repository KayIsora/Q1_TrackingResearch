index 0000000..35d7777
--- /dev/null
+++ b/tracking/stage4a_spiketrack_smoke.py
@@ -0,0 +1,421 @@
+"""Bounded Stage-4A SpikeTrack instrumentation smoke runner.
+
+This runner uses deterministic synthetic image tensors with an explicitly
+provided released tracker checkpoint.  It is a wiring/parity smoke only: it is
+not benchmark reproduction and does not assign diagnostic outcomes.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import subprocess
+import sys
+import time
+
+# Required by PyTorch deterministic CUDA matmul paths.  Set this before
+# importing torch so the CUDA context cannot be initialized first.
+os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+
+import numpy as np
+import torch
+
+
+RUNNER_ROOT = Path(__file__).resolve().parents[1]
+PROJECT_ROOT = Path(
+    os.environ.get("SPIKETRACK_STAGE4A_SOURCE_ROOT", str(RUNNER_ROOT))
+).resolve()
+if str(PROJECT_ROOT) not in sys.path:
+    sys.path.insert(0, str(PROJECT_ROOT))
+
+from lib.config.spiketrack.config import cfg, update_config_from_file
+from lib.models.spiketrack.spiketrack_inf import build_spiketrack
+from lib.test.utils.hann import hann2d
+
+
+CONTROL_SELECTORS = {
+    "mrm1": {1},
+    "mrm2": {2},
+    "mrm3": {3},
+    "mrm4": {4},
+    "mrm5": {5},
+    "mrm6": {6},
+    "early": {1, 2},
+    "middle": {3, 4},
+    "late": {5, 6},
+}
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config",
+        type=Path,
+        default=PROJECT_ROOT / "experiments/spiketrack/spiketrack_s256_t1.yaml",
+    )
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--seed", type=int, default=20260825)
+    parser.add_argument("--tolerance", type=float, default=1e-6)
+    parser.add_argument("--output-json", type=Path)
+    parser.add_argument(
+        "--clean-baseline-only",
+        action="store_true",
+        help=(
+            "Run one forward from an unmodified pinned source tree. Set "
+            "SPIKETRACK_STAGE4A_SOURCE_ROOT to that tree."
+        ),
+    )
+    return parser.parse_args()
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tensor_fingerprint(tensor):
+    value = tensor.detach().cpu().contiguous()
+    header = json.dumps(
+        {"dtype": str(value.dtype), "shape": list(value.shape)},
+        sort_keys=True,
+    ).encode("utf-8")
+    digest = hashlib.sha256(header + b"\0" + value.numpy().tobytes()).hexdigest()
+    return {
+        "dtype": str(value.dtype),
+        "shape": list(value.shape),
+        "sha256": digest,
+    }
+
+
+def output_fingerprints(result):
+    return {
+        "encoded": tensor_fingerprint(result["encoded"]),
+        "prediction_box": tensor_fingerprint(result["prediction_box"]),
+        "score_map_max": tensor_fingerprint(result["score_map_max"]),
+        "head": {
+            key: tensor_fingerprint(value)
+            for key, value in sorted(result["head"].items())
+        },
+    }
+
+
+def configure_determinism(seed):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    torch.backends.cudnn.benchmark = False
+    torch.backends.cudnn.deterministic = True
+    torch.use_deterministic_algorithms(True)
+
+
+def synchronize(device):
+    if device.type == "cuda":
+        torch.cuda.synchronize(device)
+
+
+def load_models(config_path, checkpoint_path, device):
+    allowed_configs = {"spiketrack_s256_t1.yaml", "spiketrack_s256_t3.yaml"}
+    if config_path.name not in allowed_configs:
+        raise ValueError(
+            "Stage-4A smoke accepts only released Small-256 T1/T3 configs; "
+            f"received {config_path.name}"
+        )
+    update_config_from_file(str(config_path))
+    if cfg.MODEL.ENCODER.TYPE != "Efficient_Spiking_Transformer_s":
+        raise ValueError(f"Expected Small encoder, got {cfg.MODEL.ENCODER.TYPE}")
+    if cfg.DATA.SEARCH.SIZE != 256 or cfg.TEST.SEARCH_SIZE != 256:
+        raise ValueError("Expected Small-256 config with 256-pixel search input")
+    expected_templates = 1 if config_path.stem.endswith("_t1") else 3
+    if cfg.TEST.NUM_TEMPLATES != expected_templates:
+        raise ValueError(
+            f"Config name implies T{expected_templates}, but TEST.NUM_TEMPLATES="
+            f"{cfg.TEST.NUM_TEMPLATES}"
+        )
+
+    network, encoder_temp = build_spiketrack(cfg, save_sfr=False)
+    checkpoint = torch.load(checkpoint_path, map_location="cpu")
+    if "net" not in checkpoint:
+        raise KeyError("Tracker checkpoint does not contain the required 'net' state")
+    state_dict = checkpoint["net"]
+    network_load = network.load_state_dict(state_dict, strict=False)
+    encoder_state = {
+        key.replace("encoder.", "", 1): value
+        for key, value in state_dict.items()
+        if key.startswith("encoder.")
+    }
+    encoder_load = encoder_temp.load_state_dict(encoder_state, strict=False)
+    network.to(device).eval()
+    encoder_temp.to(device).eval()
+    return network, encoder_temp, network_load, encoder_load
+
+
+def make_inputs(device, seed):
+    generator = torch.Generator(device="cpu").manual_seed(seed)
+    template_count = int(cfg.TEST.NUM_TEMPLATES)
+    template = torch.randn(
+        template_count, 1, 3, cfg.TEST.TEMPLATE_SIZE, cfg.TEST.TEMPLATE_SIZE,
+        generator=generator,
+        dtype=torch.float32,
+    ).to(device)
+    search = torch.randn(
+        1, 3, cfg.TEST.SEARCH_SIZE, cfg.TEST.SEARCH_SIZE,
+        generator=generator,
+        dtype=torch.float32,
+    ).to(device)
+    return template, search
+
+
+def run_forward(network, search, cache, device):
+    synchronize(device)
+    start = time.perf_counter()
+    with torch.inference_mode():
+        encoded = network.forward_encoder(search, cache)
+        head = network.forward_decoder(encoded)
+        score_map = head["score_map"]
+        feature_size = cfg.TEST.SEARCH_SIZE // 16
+        window = hann2d(torch.tensor([feature_size, feature_size])).to(device)
+        response = window * score_map
+        if "size_map" in head:
+            prediction_box, _ = network.decoder.cal_bbox(
+                response, head["size_map"], head["offset_map"], return_score=True
+            )
+        else:
+            prediction_box, _ = network.decoder.cal_bbox(
+                response, head["offset_map"], return_score=True
+            )
+    synchronize(device)
+    encoder_decoder_ms = (time.perf_counter() - start) * 1000.0
+    records = (
+        network.consume_stage4a_diagnostic_records()
+        if hasattr(network, "consume_stage4a_diagnostic_records")
+        else []
+    )
+    return {
+        "encoded": encoded.detach(),
+        "head": {key: value.detach() for key, value in head.items() if torch.is_tensor(value)},
+        "prediction_box": prediction_box.detach(),
+        "score_map_max": score_map.detach().max(),
+        "records": records,
+        "encoder_decoder_ms": encoder_decoder_ms,
+    }
+
+
+def max_abs_difference(left, right):
+    return float((left - right).abs().max().item())
+
+
+def compare_outputs(baseline, instrumented):
+    common_head_keys = sorted(set(baseline["head"]) & set(instrumented["head"]))
+    head_diffs = {
+        key: max_abs_difference(baseline["head"][key], instrumented["head"][key])
+        for key in common_head_keys
+    }
+    return {
+        "encoded_max_abs_diff": max_abs_difference(
+            baseline["encoded"], instrumented["encoded"]
+        ),
+        "prediction_box_max_abs_diff": max_abs_difference(
+            baseline["prediction_box"], instrumented["prediction_box"]
+        ),
+        "score_map_max_abs_diff": max_abs_difference(
+            baseline["head"]["score_map"], instrumented["head"]["score_map"]
+        ),
+        "score_max_scalar_abs_diff": abs(
+            float(baseline["score_map_max"].item())
+            - float(instrumented["score_map_max"].item())
+        ),
+        "head_tensor_max_abs_diff": max(head_diffs.values(), default=0.0),
+        "head_tensor_diffs": head_diffs,
+    }
+
+
+def main():
+    args = parse_args()
+    config_path = args.config.resolve()
+    checkpoint_path = args.checkpoint.resolve()
+    if not config_path.is_file():
+        raise FileNotFoundError(config_path)
+    if not checkpoint_path.is_file():
+        raise FileNotFoundError(checkpoint_path)
+    device = torch.device(args.device)
+    if device.type == "cuda" and not torch.cuda.is_available():
+        raise RuntimeError("CUDA device requested but torch.cuda.is_available() is false")
+
+    configure_determinism(args.seed)
+    network, encoder_temp, network_load, encoder_load = load_models(
+        config_path, checkpoint_path, device
+    )
+    template, search = make_inputs(device, args.seed)
+    with torch.inference_mode():
+        cache, _ = encoder_temp(template)
+
+    if args.clean_baseline_only:
+        baseline = run_forward(network, search, cache, device)
+        try:
+            pinned_commit = subprocess.check_output(
+                ["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, text=True
+            ).strip()
+        except (OSError, subprocess.CalledProcessError):
+            pinned_commit = "UNAVAILABLE"
+        report = {
+            "scope": "STAGE4A_CLEAN_PINNED_BASELINE_SYNTHETIC_FORWARD",
+            "run_mode": "original_pinned_baseline",
+            "source_root": str(PROJECT_ROOT),
+            "pinned_commit": pinned_commit,
+            "config": str(config_path),
+            "checkpoint": str(checkpoint_path),
+            "checkpoint_sha256": sha256_file(checkpoint_path),
+            "tracker_mode": f"T{cfg.TEST.NUM_TEMPLATES}",
+            "dtype": "torch.float32",
+            "device": str(device),
+            "seed": args.seed,
+            "deterministic_settings": {
+                "cublas_workspace_config": os.environ.get("CUBLAS_WORKSPACE_CONFIG"),
+                "cudnn_benchmark": bool(torch.backends.cudnn.benchmark),
+                "cudnn_deterministic": bool(torch.backends.cudnn.deterministic),
+                "torch_deterministic_algorithms": bool(
+                    torch.are_deterministic_algorithms_enabled()
+                ),
+            },
+            "checkpoint_load": {
+                "network_missing_keys": list(network_load.missing_keys),
+                "network_unexpected_keys": list(network_load.unexpected_keys),
+                "template_encoder_missing_keys": list(encoder_load.missing_keys),
+                "template_encoder_unexpected_keys": list(
+                    encoder_load.unexpected_keys
+                ),
+            },
+            "output_fingerprints": output_fingerprints(baseline),
+            "encoder_decoder_ms": baseline["encoder_decoder_ms"],
+        }
+        rendered = json.dumps(report, indent=2, sort_keys=True)
+        print(rendered)
+        if args.output_json:
+            args.output_json.parent.mkdir(parents=True, exist_ok=True)
+            args.output_json.write_text(rendered + "\n", encoding="utf-8")
+        return
+
+    # A: instrumentation disabled. B: logging enabled, no ablation. Both use
+    # the same model, checkpoint, cache and immutable synthetic search tensor.
+    network.configure_stage4a_diagnostics(enabled=False, ablation="none")
+    baseline = run_forward(network, search, cache, device)
+    network.configure_stage4a_diagnostics(enabled=True, ablation="none")
+    instrumented = run_forward(network, search, cache, device)
+    parity_diffs = compare_outputs(baseline, instrumented)
+    parity_max = max(
+        parity_diffs["encoded_max_abs_diff"],
+        parity_diffs["prediction_box_max_abs_diff"],
+        parity_diffs["score_map_max_abs_diff"],
+        parity_diffs["score_max_scalar_abs_diff"],
+        parity_diffs["head_tensor_max_abs_diff"],
+    )
+    parity_pass = parity_max <= args.tolerance
+    if len(instrumented["records"]) != 6:
+        raise AssertionError(
+            f"Expected six MRM records, got {len(instrumented['records'])}"
+        )
+
+    control_results = []
+    for selector, selected_ids in CONTROL_SELECTORS.items():
+        network.configure_stage4a_diagnostics(enabled=True, ablation=selector)
+        result = run_forward(network, search, cache, device)
+        records = result["records"]
+        if len(records) != 6:
+            raise AssertionError(f"{selector}: expected six MRM records, got {len(records)}")
+        applied_ids = {
+            int(record["mrm_id"].replace("MRM", ""))
+            for record in records
+            if record["zero_residual_applied"]
+        }
+        if applied_ids != selected_ids:
+            raise AssertionError(
+                f"{selector}: applied {sorted(applied_ids)}, expected {sorted(selected_ids)}"
+            )
+        if any(record["physical_skip"] for record in records):
+            raise AssertionError(f"{selector}: a control incorrectly reported physical skipping")
+        finite = all(torch.isfinite(value).all().item() for value in result["head"].values())
+        control_results.append({
+            "selector": selector,
+            "selected_mrms": sorted(selected_ids),
+            "all_six_mrms_executed": True,
+            "physical_skip": False,
+            "head_outputs_finite": bool(finite),
+            "encoder_decoder_ms": result["encoder_decoder_ms"],
+        })
+
+    try:
+        pinned_commit = subprocess.check_output(
+            ["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, text=True
+        ).strip()
+    except (OSError, subprocess.CalledProcessError):
+        pinned_commit = "UNAVAILABLE"
+
+    report = {
+        "scope": "STAGE4A_SYNTHETIC_SMOKE_ONLY_NOT_BENCHMARK_REPRODUCTION",
+        "run_mode": "instrumented_default_off_then_logging_on_no_ablation",
+        "source_root": str(PROJECT_ROOT),
+        "pinned_commit": pinned_commit,
+        "config": str(config_path),
+        "checkpoint": str(checkpoint_path),
+        "checkpoint_sha256": sha256_file(checkpoint_path),
+        "tracker_mode": f"T{cfg.TEST.NUM_TEMPLATES}",
+        "dtype": "torch.float32",
+        "device": str(device),
+        "seed": args.seed,
+        "deterministic_algorithms": True,
+        "deterministic_settings": {
+            "cublas_workspace_config": os.environ.get("CUBLAS_WORKSPACE_CONFIG"),
+            "cudnn_benchmark": bool(torch.backends.cudnn.benchmark),
+            "cudnn_deterministic": bool(torch.backends.cudnn.deterministic),
+            "torch_deterministic_algorithms": bool(
+                torch.are_deterministic_algorithms_enabled()
+            ),
+        },
+        "checkpoint_load": {
+            "network_missing_keys": list(network_load.missing_keys),
+            "network_unexpected_keys": list(network_load.unexpected_keys),
+            "template_encoder_missing_keys": list(encoder_load.missing_keys),
+            "template_encoder_unexpected_keys": list(encoder_load.unexpected_keys),
+        },
+        "parity": {
+            "tolerance": args.tolerance,
+            "maximum_observed_abs_diff": parity_max,
+            "pass": parity_pass,
+            **parity_diffs,
+        },
+        "timing_semantics": {
+            "mrm_module_latency_ms": "individual MRM; CUDA-synchronized on CUDA",
+            "total_model_forward_ms": "search encoder only; CUDA-synchronized on CUDA",
+            "encoder_decoder_ms": "runner search encoder plus decoder; CUDA-synchronized on CUDA",
+            "total_tracker_model_forward_ms": (
+                "tracker search encoder plus decoder; emitted by lib/test/tracker/spiketrack_inf.py"
+            ),
+        },
+        "baseline_encoder_decoder_ms": baseline["encoder_decoder_ms"],
+        "instrumented_encoder_decoder_ms": instrumented["encoder_decoder_ms"],
+        "instrumented_mrm_records": instrumented["records"],
+        "baseline_output_fingerprints": output_fingerprints(baseline),
+        "instrumented_output_fingerprints": output_fingerprints(instrumented),
+        "controls": control_results,
+    }
+    rendered = json.dumps(report, indent=2, sort_keys=True)
+    print(rendered)
+    if args.output_json:
+        args.output_json.parent.mkdir(parents=True, exist_ok=True)
+        args.output_json.write_text(rendered + "\n", encoding="utf-8")
+    if not parity_pass:
+        raise SystemExit(2)
+    if not all(item["head_outputs_finite"] for item in control_results):
+        raise SystemExit(3)
+
+
+if __name__ == "__main__":
+    main()
