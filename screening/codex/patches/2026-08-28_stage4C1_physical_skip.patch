+        clean_reference_parity = (
+            compare_reference_arrays(
+                args.reference_tensors.resolve(), baseline, args.tolerance
+            )
+            if args.reference_tensors else None
+        )
+        try:
+            pinned_commit = subprocess.check_output(
+                ["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, text=True
+            ).strip()
+        except (OSError, subprocess.CalledProcessError):
+            pinned_commit = "UNAVAILABLE"
+        report = {
+            "scope": (
+                "STAGE4A_CLEAN_PINNED_BASELINE_BOUNDED_REAL_IMAGE_ONE_FRAME"
