+        config_path, checkpoint_path, device
+    )
+    template, search, input_metadata = make_inputs(device, args.seed, args)
+    with torch.inference_mode():
+        cache, _ = encoder_temp(template)
+
+    if args.clean_baseline_only:
+        baseline = run_forward(network, search, cache, device)
