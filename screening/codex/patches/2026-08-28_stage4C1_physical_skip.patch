@@ -0,0 +1,707 @@
+"""Bounded Stage-4A SpikeTrack instrumentation smoke runner.
+
+This runner uses deterministic synthetic tensors or a bounded pair of real
+source frames with an explicitly provided released tracker checkpoint.  It is
+a wiring/parity smoke only: it is not benchmark reproduction and does not
+assign diagnostic outcomes.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import subprocess
+import sys
+import time
+
+# Required by PyTorch deterministic CUDA matmul paths.  Set this before
+# importing torch so the CUDA context cannot be initialized first.
+os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+
+import numpy as np
+import torch
+
+
+RUNNER_ROOT = Path(__file__).resolve().parents[1]
+PROJECT_ROOT = Path(
+    os.environ.get("SPIKETRACK_STAGE4A_SOURCE_ROOT", str(RUNNER_ROOT))
+).resolve()
+if str(PROJECT_ROOT) not in sys.path:
+    sys.path.insert(0, str(PROJECT_ROOT))
+
+from lib.config.spiketrack.config import cfg, update_config_from_file
+from lib.models.spiketrack.spiketrack_inf import build_spiketrack
+from lib.test.utils.hann import hann2d
+
+
+WHOLE_CONTROL_SELECTORS = {
+    "mrm1": {1},
+    "mrm2": {2},
+    "mrm3": {3},
+    "mrm4": {4},
+    "mrm5": {5},
+    "mrm6": {6},
+    "early": {1, 2},
+    "middle": {3, 4},
+    "late": {5, 6},
+}
+
+
+def control_specs(template_count):
+    specs = [
+        {
+            "selector": selector,
+            "kind": "whole",
+            "selected_mrms": selected_ids,
+            "template_path": None,
+        }
+        for selector, selected_ids in WHOLE_CONTROL_SELECTORS.items()
+    ]
+    for mrm_number in range(1, 7):
+        for kind in ("retriever", "mlp"):
+            specs.append({
+                "selector": f"mrm{mrm_number}_{kind}",
+                "kind": kind,
+                "selected_mrms": {mrm_number},
+                "template_path": None,
+            })
+        if template_count == 3:
+            for template_path in range(1, 4):
+                specs.append({
+                    "selector": f"mrm{mrm_number}_template{template_path}",
+                    "kind": "template",
+                    "selected_mrms": {mrm_number},
+                    "template_path": template_path,
+                })
+    return specs
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config",
+        type=Path,
+        default=PROJECT_ROOT / "experiments/spiketrack/spiketrack_s256_t1.yaml",
+    )
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--seed", type=int, default=20260825)
+    parser.add_argument("--tolerance", type=float, default=1e-6)
+    parser.add_argument("--output-json", type=Path)
+    parser.add_argument(
+        "--output-tensors",
+        type=Path,
+        help="Write uncommitted NPZ outputs for clean-versus-refined comparison.",
+    )
+    parser.add_argument(
+        "--reference-tensors",
+        type=Path,
+        help="NPZ produced by a clean pinned run; report direct max-abs parity.",
+    )
+    parser.add_argument(
+        "--real-template-image",
+        type=Path,
+        help="Real RGB source frame used for the initialization crop.",
+    )
+    parser.add_argument(
+        "--real-search-image",
+        type=Path,
+        help="Real RGB source frame used for the one-frame search crop.",
+    )
+    parser.add_argument(
+        "--real-init-box",
+        type=float,
+        nargs=4,
+        metavar=("X", "Y", "W", "H"),
+        help="Initialization box for bounded real-image preprocessing.",
+    )
+    parser.add_argument(
+        "--clean-baseline-only",
+        action="store_true",
+        help=(
+            "Run one forward from an unmodified pinned source tree. Set "
+            "SPIKETRACK_STAGE4A_SOURCE_ROOT to that tree."
+        ),
+    )
+    return parser.parse_args()
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tensor_fingerprint(tensor):
+    value = tensor.detach().cpu().contiguous()
+    header = json.dumps(
+        {"dtype": str(value.dtype), "shape": list(value.shape)},
+        sort_keys=True,
+    ).encode("utf-8")
+    digest = hashlib.sha256(header + b"\0" + value.numpy().tobytes()).hexdigest()
+    return {
+        "dtype": str(value.dtype),
+        "shape": list(value.shape),
+        "sha256": digest,
+    }
+
+
+def output_fingerprints(result):
+    return {
+        "encoded": tensor_fingerprint(result["encoded"]),
+        "prediction_box": tensor_fingerprint(result["prediction_box"]),
+        "score_map_max": tensor_fingerprint(result["score_map_max"]),
+        "head": {
+            key: tensor_fingerprint(value)
+            for key, value in sorted(result["head"].items())
+        },
+    }
+
+
+def result_arrays(result):
+    arrays = {
+        "encoded": result["encoded"].detach().cpu().numpy(),
+        "prediction_box": result["prediction_box"].detach().cpu().numpy(),
+        "score_map_max": result["score_map_max"].detach().cpu().numpy(),
+    }
+    arrays.update({
+        f"head__{key}": value.detach().cpu().numpy()
+        for key, value in sorted(result["head"].items())
+    })
+    return arrays
+
+
+def write_result_arrays(path, result):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    np.savez_compressed(path, **result_arrays(result))
+
+
+def compare_reference_arrays(path, result, tolerance):
+    current = result_arrays(result)
+    with np.load(path, allow_pickle=False) as reference:
+        reference_keys = set(reference.files)
+        current_keys = set(current)
+        if reference_keys != current_keys:
+            raise AssertionError({
+                "missing_from_current": sorted(reference_keys - current_keys),
+                "missing_from_reference": sorted(current_keys - reference_keys),
+            })
+        differences = {}
+        for key in sorted(current):
+            if reference[key].shape != current[key].shape:
+                raise AssertionError(
+                    f"{key}: reference shape {reference[key].shape} != current {current[key].shape}"
+                )
+            differences[key] = float(
+                np.max(np.abs(reference[key] - current[key]), initial=0.0)
+            )
+    maximum = max(differences.values(), default=0.0)
+    return {
+        "reference_tensors": str(path.resolve()),
+        "tolerance": tolerance,
+        "tensor_max_abs_diffs": differences,
+        "maximum_observed_abs_diff": maximum,
+        "pass": maximum <= tolerance,
+    }
+
+
+def configure_determinism(seed):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    torch.backends.cudnn.benchmark = False
+    torch.backends.cudnn.deterministic = True
+    torch.use_deterministic_algorithms(True)
+
+
+def synchronize(device):
+    if device.type == "cuda":
+        torch.cuda.synchronize(device)
+
+
+def load_models(config_path, checkpoint_path, device):
+    allowed_configs = {"spiketrack_s256_t1.yaml", "spiketrack_s256_t3.yaml"}
+    if config_path.name not in allowed_configs:
+        raise ValueError(
+            "Stage-4A smoke accepts only released Small-256 T1/T3 configs; "
+            f"received {config_path.name}"
+        )
+    update_config_from_file(str(config_path))
+    if cfg.MODEL.ENCODER.TYPE != "Efficient_Spiking_Transformer_s":
+        raise ValueError(f"Expected Small encoder, got {cfg.MODEL.ENCODER.TYPE}")
+    if cfg.DATA.SEARCH.SIZE != 256 or cfg.TEST.SEARCH_SIZE != 256:
+        raise ValueError("Expected Small-256 config with 256-pixel search input")
+    expected_templates = 1 if config_path.stem.endswith("_t1") else 3
+    if cfg.TEST.NUM_TEMPLATES != expected_templates:
+        raise ValueError(
+            f"Config name implies T{expected_templates}, but TEST.NUM_TEMPLATES="
+            f"{cfg.TEST.NUM_TEMPLATES}"
+        )
+
+    network, encoder_temp = build_spiketrack(cfg, save_sfr=False)
+    checkpoint = torch.load(checkpoint_path, map_location="cpu")
+    if "net" not in checkpoint:
+        raise KeyError("Tracker checkpoint does not contain the required 'net' state")
+    state_dict = checkpoint["net"]
+    network_load = network.load_state_dict(state_dict, strict=False)
+    encoder_state = {
+        key.replace("encoder.", "", 1): value
+        for key, value in state_dict.items()
+        if key.startswith("encoder.")
+    }
+    encoder_load = encoder_temp.load_state_dict(encoder_state, strict=False)
+    network.to(device).eval()
+    encoder_temp.to(device).eval()
+    return network, encoder_temp, network_load, encoder_load
+
+
+def _normalize_rgb_crop(image, device):
+    mean = torch.tensor([0.485, 0.456, 0.406], device=device).view(1, 3, 1, 1)
+    std = torch.tensor([0.229, 0.224, 0.225], device=device).view(1, 3, 1, 1)
+    tensor = (
+        torch.from_numpy(image.copy())
+        .to(device=device, dtype=torch.float32)
+        .permute(2, 0, 1)
+        .unsqueeze(0)
+    )
+    return ((tensor / 255.0) - mean) / std
+
+
+def make_inputs(device, seed, args):
+    real_arguments = (
+        args.real_template_image,
+        args.real_search_image,
+        args.real_init_box,
+    )
+    if any(value is not None for value in real_arguments):
+        if not all(value is not None for value in real_arguments):
+            raise ValueError(
+                "Real-image mode requires --real-template-image, "
+                "--real-search-image, and --real-init-box together"
+            )
+        import cv2
+        from lib.test.tracker.seqtrack_utils import sample_target
+
+        def read_rgb(path):
+            bgr = cv2.imread(str(path))
+            if bgr is None:
+                raise FileNotFoundError(path)
+            return cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
+
+        template_rgb = read_rgb(args.real_template_image.resolve())
+        search_rgb = read_rgb(args.real_search_image.resolve())
+        init_box = [float(value) for value in args.real_init_box]
+        template_crop, _ = sample_target(
+            template_rgb,
+            init_box,
+            cfg.TEST.TEMPLATE_FACTOR,
+            output_sz=cfg.TEST.TEMPLATE_SIZE,
+        )
+        search_crop, _ = sample_target(
+            search_rgb,
+            init_box,
+            cfg.TEST.SEARCH_FACTOR,
+            output_sz=cfg.TEST.SEARCH_SIZE,
+        )
+        one_template = _normalize_rgb_crop(template_crop, device)
+        template = torch.stack(
+            [one_template] * int(cfg.TEST.NUM_TEMPLATES), dim=0
+        )
+        search = _normalize_rgb_crop(search_crop, device)
+        metadata = {
+            "input_mode": "real_image_one_frame",
+            "template_image": str(args.real_template_image.resolve()),
+            "search_image": str(args.real_search_image.resolve()),
+            "initialization_box": init_box,
+            "t3_initialization_contract": (
+                "repeat the initial template three times, matching SpikeTrack.initialize"
+                if int(cfg.TEST.NUM_TEMPLATES) == 3
+                else "single initial template"
+            ),
+        }
+        return template, search, metadata
+
+    generator = torch.Generator(device="cpu").manual_seed(seed)
+    template_count = int(cfg.TEST.NUM_TEMPLATES)
+    template = torch.randn(
+        template_count, 1, 3, cfg.TEST.TEMPLATE_SIZE, cfg.TEST.TEMPLATE_SIZE,
+        generator=generator,
+        dtype=torch.float32,
+    ).to(device)
+    search = torch.randn(
+        1, 3, cfg.TEST.SEARCH_SIZE, cfg.TEST.SEARCH_SIZE,
+        generator=generator,
+        dtype=torch.float32,
+    ).to(device)
+    return template, search, {
+        "input_mode": "deterministic_synthetic",
+        "template_image": None,
+        "search_image": None,
+        "initialization_box": None,
+        "t3_initialization_contract": None,
+    }
+
+
+def run_forward(network, search, cache, device):
+    synchronize(device)
+    start = time.perf_counter()
+    with torch.inference_mode():
+        encoded = network.forward_encoder(search, cache)
+        head = network.forward_decoder(encoded)
+        score_map = head["score_map"]
+        feature_size = cfg.TEST.SEARCH_SIZE // 16
+        window = hann2d(torch.tensor([feature_size, feature_size])).to(device)
+        response = window * score_map
+        if "size_map" in head:
+            prediction_box, _ = network.decoder.cal_bbox(
+                response, head["size_map"], head["offset_map"], return_score=True
+            )
+        else:
+            prediction_box, _ = network.decoder.cal_bbox(
+                response, head["offset_map"], return_score=True
+            )
+    synchronize(device)
+    encoder_decoder_ms = (time.perf_counter() - start) * 1000.0
+    records = (
+        network.consume_stage4a_diagnostic_records()
+        if hasattr(network, "consume_stage4a_diagnostic_records")
+        else []
+    )
+    return {
+        "encoded": encoded.detach(),
+        "head": {key: value.detach() for key, value in head.items() if torch.is_tensor(value)},
+        "prediction_box": prediction_box.detach(),
+        "score_map_max": score_map.detach().max(),
+        "records": records,
+        "encoder_decoder_ms": encoder_decoder_ms,
+    }
+
+
+def max_abs_difference(left, right):
+    return float((left - right).abs().max().item())
+
+
+def compare_outputs(baseline, instrumented):
+    common_head_keys = sorted(set(baseline["head"]) & set(instrumented["head"]))
+    head_diffs = {
+        key: max_abs_difference(baseline["head"][key], instrumented["head"][key])
+        for key in common_head_keys
+    }
+    return {
+        "encoded_max_abs_diff": max_abs_difference(
+            baseline["encoded"], instrumented["encoded"]
+        ),
+        "prediction_box_max_abs_diff": max_abs_difference(
+            baseline["prediction_box"], instrumented["prediction_box"]
+        ),
+        "score_map_max_abs_diff": max_abs_difference(
+            baseline["head"]["score_map"], instrumented["head"]["score_map"]
+        ),
+        "score_max_scalar_abs_diff": abs(
+            float(baseline["score_map_max"].item())
+            - float(instrumented["score_map_max"].item())
+        ),
+        "head_tensor_max_abs_diff": max(head_diffs.values(), default=0.0),
+        "head_tensor_diffs": head_diffs,
+    }
+
+
+def main():
+    args = parse_args()
+    config_path = args.config.resolve()
+    checkpoint_path = args.checkpoint.resolve()
+    if not config_path.is_file():
+        raise FileNotFoundError(config_path)
+    if not checkpoint_path.is_file():
+        raise FileNotFoundError(checkpoint_path)
+    device = torch.device(args.device)
+    if device.type == "cuda" and not torch.cuda.is_available():
+        raise RuntimeError("CUDA device requested but torch.cuda.is_available() is false")
+
+    configure_determinism(args.seed)
