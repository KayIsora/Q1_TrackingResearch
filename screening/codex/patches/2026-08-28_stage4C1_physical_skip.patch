+        if any(not record["all_retriever_and_mlp_compute_executed"] for record in records):
+            raise AssertionError(f"{selector}: component computation was not fully executed")
+        selected_records = [
+            record for record in records
+            if int(record["mrm_id"].replace("MRM", "")) in selected_ids
+        ]
+        if any(record["control_kind"] != spec["kind"] for record in selected_records):
+            raise AssertionError(f"{selector}: control-kind mismatch")
+        if spec["kind"] == "whole" and any(
+            not record["whole_mrm_bypass_applied"] for record in selected_records
