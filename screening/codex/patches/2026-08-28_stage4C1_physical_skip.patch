+
+
+SOURCE_ROOT = Path(__file__).resolve().parents[1]
+CONFIG = SOURCE_ROOT / "experiments/spiketrack/spiketrack_s256_t1.yaml"
+CHECKPOINT = Path(
+    r"E:\Robot_Backup\tmp\stage2B_spiketrack\ckpt\spiketrack_s256_t1.pth.tar"
+)
+DATASET = Path(
+    r"F:\Q1_TrackingResearch_Data\OTB100_Figshare_24427468_v1\extracted\OTB2015"
+)
+
+
+def run_mode(network, search, cache, device, stage4a_selector, physical_mode,
+             capture_features=False):
+    network.configure_stage4a_diagnostics(
+        enabled=stage4a_selector != "none", ablation=stage4a_selector
+    )
+    network.configure_stage4c1(
+        physical_mode=physical_mode, capture_features=capture_features,
+        record_call_counts=True,
+    )
+    result = stage4a.run_forward(network, search, cache, device)
+    return result, network.stage4c1_last_call_counts(), (
+        network.consume_stage4c1_feature_records()
+        if capture_features else []
+    )
+
+
+def main():
+    device = torch.device("cuda")
+    stage4a.configure_determinism(20260828)
+    network, encoder_temp, _, _ = stage4a.load_models(
+        CONFIG, CHECKPOINT, device
+    )
+    args = Namespace(
+        real_template_image=DATASET / "Singer1/img/0001.jpg",
+        real_search_image=DATASET / "Singer1/img/0002.jpg",
